<?xml version="1.0" encoding="UTF-8"?>
<!-- Upload verbatim as the ONE THR-346 msg6 authorized job; no substitutions. -->
<project>
  <actions/>
  <description>HappyRanch manual Mac native probe. THR-346 S0 and later separately authorized suites. Explicit immutable SOURCE_SHA only; no deployment or daemon restart.</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <jenkins.model.BuildDiscarderProperty>
      <strategy class="hudson.tasks.LogRotator">
        <daysToKeep>30</daysToKeep><numToKeep>20</numToKeep>
        <artifactDaysToKeep>30</artifactDaysToKeep><artifactNumToKeep>20</artifactNumToKeep>
      </strategy>
    </jenkins.model.BuildDiscarderProperty>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.StringParameterDefinition>
          <name>SOURCE_SHA</name><description>Required: exactly 40 hexadecimal commit characters.</description>
          <defaultValue/><trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>SUITE</name><description>Validated by the pinned dispatcher allowlist. S0 supports truth only.</description>
          <defaultValue>truth</defaultValue><trim>false</trim>
        </hudson.model.StringParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
  </properties>
  <scm class="hudson.scm.NullSCM"/>
  <assignedNode>mac-mini</assignedNode>
  <canRoam>false</canRoam><disabled>false</disabled>
  <blockBuildWhenDownstreamBuilding>false</blockBuildWhenDownstreamBuilding>
  <blockBuildWhenUpstreamBuilding>false</blockBuildWhenUpstreamBuilding>
  <triggers/><concurrentBuild>false</concurrentBuild>
  <builders>
    <hudson.tasks.Shell>
      <command><![CDATA[#!/bin/bash -p
set +x
set -euo pipefail
exec 3>&1 4>&2
unset BASH_ENV ENV CDPATH GIT_DIR GIT_WORK_TREE GIT_CONFIG GIT_CONFIG_COUNT GIT_CONFIG_PARAMETERS
export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export LC_ALL=C GIT_TERMINAL_PROMPT=0 GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
umask 077
CONSOLE_LIMIT_BYTES=1048576
# All console writes, including saved-fd and cleanup diagnostics, share this cap.
# Drain excess input so a full console cannot SIGPIPE cleanup or replace its rc.
capture_console() {
  local rc=0 extra
  trap '' INT TERM HUP PIPE
  head -c "$CONSOLE_LIMIT_BYTES" || rc=1
  if extra=$(head -c 1 | wc -c); then
    if [ "$extra" -ne 0 ]; then
      printf '\n[console output truncated at %s bytes]\n' "$CONSOLE_LIMIT_BYTES" || rc=1
      rc=1
    fi
  else
    rc=1
  fi
  cat > /dev/null || rc=1
  return "$rc"
}
# Bootstrap failures remain nonzero; suppress diagnostics until the cap is active.
exec 2>/dev/null
: "${WORKSPACE:?Jenkins workspace required}"
cd "$WORKSPACE"
mkdir -p evidence
# Only these job-owned outputs are replaced; the checkout is always freshly created.
rm -f evidence/probe.json evidence/probe.log evidence/identity.txt evidence/build.log evidence/.console-pipe
mkfifo evidence/.console-pipe
# An ordinary child can be waited for on the Mac's shipped Bash 3.2.
capture_console < evidence/.console-pipe >&3 2>/dev/null &
console_pid=$!
exec > evidence/.console-pipe 2>&1
exec 3>&1 4>&2
finish_console() {
  local rc=${1:-$?}
  trap - EXIT
  if ! rm -f -- "$WORKSPACE/evidence/.console-pipe"; then
    [ "$rc" -ne 0 ] || rc=1
  fi
  if ! exec 1>&- 2>&- 3>&- 4>&-; then
    [ "$rc" -ne 0 ] || rc=1
  fi
  if ! wait "$console_pid"; then
    [ "$rc" -ne 0 ] || rc=1
  fi
  exit "$rc"
}
trap finish_console EXIT
scratch=''
LOG_LIMIT_BYTES=4194304
IDENTITY_LIMIT_BYTES=65536
# Read one byte beyond the cap to distinguish exact-size output from overflow.
# The writer closes its pipe on overflow; pipefail makes the build fail closed.
capture_log() {
  local limit=${2:-$LOG_LIMIT_BYTES} extra
  head -c "$limit" > "$1" || return 1
  extra=$(head -c 1 | wc -c) || return 1
  if [ "$extra" -ne 0 ]; then
    printf 'Log exceeded %s bytes: %s\n' "$limit" "$1" >&4
    return 1
  fi
}
cleanup() {
  local rc=$? removed size
  trap - EXIT
  set +e
  if [ -n "$scratch" ]; then
    if rm -rf -- "$scratch"; then
      removed=true
    else
      removed=false
      [ "$rc" -ne 0 ] || rc=1
    fi
    # The identity producer reserves 22 bytes for the longest possible receipt.
    if ! printf 'scratch_removed=%s\n' "$removed" >> "$WORKSPACE/evidence/identity.txt"; then
      [ "$rc" -ne 0 ] || rc=1
    fi
  fi
  if [ -f "$WORKSPACE/evidence/build.log" ]; then
    if ! head -c "$CONSOLE_LIMIT_BYTES" "$WORKSPACE/evidence/build.log" >&3; then
      [ "$rc" -ne 0 ] || rc=1
    fi
    if size=$(wc -c < "$WORKSPACE/evidence/build.log"); then
      if [ "$size" -gt "$CONSOLE_LIMIT_BYTES" ]; then
        [ "$rc" -ne 0 ] || rc=1
        if ! printf '\n[build.log console copy truncated at %s bytes]\n' "$CONSOLE_LIMIT_BYTES" >&3; then
          [ "$rc" -ne 0 ] || rc=1
        fi
      fi
    else
      [ "$rc" -ne 0 ] || rc=1
    fi
  fi
  finish_console "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
run_probe() {
  [[ "${SOURCE_SHA:-}" =~ ^[0-9a-fA-F]{40}$ ]] || { echo 'SOURCE_SHA must be 40 hex characters'; return 2; }
  [[ "${SUITE:-}" =~ ^[a-z][a-z0-9-]{0,47}$ ]] || { echo 'Invalid SUITE syntax'; return 2; }
  test "$(uname -s)" = Darwin
  mkdir "$scratch/source"
  cd "$scratch/source"
  git init --quiet
  git remote add origin https://github.com/t-benze/happyranch.git
  # Do not use a full refspec or SCM plugin: fetch only the requested commit.
  git -c credential.helper= fetch --no-tags --depth 1 origin "$SOURCE_SHA"
  git checkout --quiet --detach FETCH_HEAD
  actual=$(git rev-parse HEAD)
  expected=$(printf '%s' "$SOURCE_SHA" | tr 'A-F' 'a-f')
  test "$actual" = "$expected"
  {
    printf 'source_sha=%s\nsuite=%s\nnode=%s\n' "$actual" "$SUITE" "${NODE_NAME:-}"
    printf 'job=%s\nbuild_number=%s\nbuild_url=%s\n' "${JOB_NAME:-}" "${BUILD_NUMBER:-}" "${BUILD_URL:-}"
    command -v python3
    python3 --version
  } 2>&1 | capture_log "$WORKSPACE/evidence/identity.txt" "$((IDENTITY_LIMIT_BYTES - 22))"
  (
    # Bash -p (not POSIX mode): -f uses 1024-byte blocks, including Apple 3.2.
    # One 32 MiB per-file cap covers both dependency bootstrap and probe.json.
    ulimit -f 32768
    unset PYTHONPATH PYTHONHOME
    export HOME="$scratch/home" XDG_CACHE_HOME="$scratch/cache"
    export PIP_CACHE_DIR="$scratch/cache/pip" PIP_NO_CACHE_DIR=1 PIP_CONFIG_FILE=/dev/null
    export PYTHONNOUSERSITE=1 PYTHONUSERBASE="$scratch/user" PYTHONDONTWRITEBYTECODE=1
    export TMPDIR="$scratch/tmp"
    mkdir -p "$HOME" "$XDG_CACHE_HOME" "$TMPDIR"
    # Stdlib only; no ensurepip, index resolution, sdist, or persistent install.
    python3 -I -B - "$scratch" <<'BOOTSTRAP_PY'
from __future__ import annotations

import hashlib
import platform
import re
import signal
import stat
import subprocess
import sys
import time
import tomllib
import urllib.parse
import urllib.request
import zipfile
from pathlib import Path

WHEEL_CAP = 16 * 1024 * 1024
DOWNLOAD_CAP = 64 * 1024 * 1024
EXTRACT_CAP = 128 * 1024 * 1024
FILE_CAP = 32 * 1024 * 1024
# Measured cleanup-helpers import set; versions/artifacts come only from uv.lock.
# No metadata resolution, optional extras, entry points, pip, uv, or sdists.
NEEDED = '''annotated-doc annotated-types anyio click fastapi pydantic
pydantic-core pydantic-settings python-dateutil python-dotenv python-multipart
pyyaml six sse-starlette starlette typing-extensions typing-inspection uvicorn'''.split()
DEADLINE = time.monotonic() + 300


def fail(message: str) -> None:
    raise RuntimeError(message)


def remaining() -> float:
    value = DEADLINE - time.monotonic()
    if value <= 0:
        fail('300-second bootstrap deadline exceeded')
    return value


def alarm_timeout(signum: int, frame: object) -> None:
    fail('300-second bootstrap deadline exceeded')


def compatible(filename: str) -> bool:
    fields = filename.removesuffix('.whl').rsplit('-', 3)
    if not filename.endswith('.whl') or len(fields) != 4:
        return False
    _, python_tags, abi_tags, platform_tags = fields
    for python_tag in python_tags.split('.'):
        for abi_tag in abi_tags.split('.'):
            for platform_tag in platform_tags.split('.'):
                if python_tag == 'py3' and abi_tag == 'none' and platform_tag == 'any':
                    return True
                match = re.fullmatch(r'macosx_(\d+)_(\d+)_(arm64|universal2)', platform_tag)
                if not match or tuple(map(int, match.group(1, 2))) > MAC_VERSION:
                    continue
                if python_tag == 'cp314' and abi_tag == 'cp314':
                    return True
                if re.fullmatch(r'cp3\d+', python_tag) and abi_tag == 'abi3':
                    if 32 <= int(python_tag[2:]) <= 314:
                        return True
    return False


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req: urllib.request.Request, fp: object, code: int,
                         msg: str, headers: object, newurl: str) -> None:
        fail('wheel redirect refused')


def bootstrap() -> None:
    global MAC_VERSION
    if (platform.system(), platform.machine(), sys.version_info[:2]) != ('Darwin', 'arm64', (3, 14)):
        fail('requires macOS arm64 CPython 3.14 (regular GIL build)')
    if sysconfig_gil_disabled():
        fail('free-threaded CPython is unsupported')
    MAC_VERSION = tuple(map(int, platform.mac_ver()[0].split('.')[:2]))
    scratch = Path(sys.argv[1]).resolve(strict=True)
    with Path('uv.lock').open('rb') as handle:
        lock = tomllib.load(handle)
    selected = []
    for name in NEEDED:
        packages = [p for p in lock['package'] if p['name'] == name]
        if len(packages) != 1:
            fail(f'{name}: missing or ambiguous locked package')
        package = packages[0]
        candidates = []
        for wheel in package.get('wheels', []):
            url = urllib.parse.urlsplit(wheel['url'])
            filename = url.path.rsplit('/', 1)[-1]
            if not compatible(filename):
                continue
            if url.scheme != 'https' or url.netloc != 'files.pythonhosted.org' or url.query or url.fragment:
                fail(f'{name}: unexpected wheel origin')
            expected_prefix = name.replace('-', '_') + '-' + package['version'] + '-'
            if not filename.startswith(expected_prefix):
                fail(f'{name}: wheel identity mismatch')
            if not re.fullmatch(r'sha256:[0-9a-f]{64}', wheel.get('hash', '')):
                fail(f'{name}: missing locked SHA256')
            size = wheel.get('size')
            if type(size) is not int or not 0 < size <= WHEEL_CAP:
                fail(f'{name}: missing size or wheel exceeds 16 MiB cap')
            candidates.append((filename, wheel))
        if not candidates:
            fail(f'{name}: missing compatible locked wheel')
        selected.append((name, *sorted(candidates, key=lambda item: item[0])[0]))
    if sum(wheel['size'] for _, _, wheel in selected) > DOWNLOAD_CAP:
        fail('locked downloads exceed 64 MiB total cap')
    venv = scratch / 'venv'
    subprocess.run([sys.executable, '-I', '-B', '-m', 'venv', '--without-pip', str(venv)],
                   check=True, timeout=remaining())
    site = venv / 'lib/python3.14/site-packages'
    site.mkdir(parents=True, exist_ok=True)
    downloads = scratch / 'wheels'
    downloads.mkdir()
    # Ignore ambient proxies (and their credentials); no cache or index client.
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
    downloaded = extracted = members = largest = 0
    largest_name = ''
    destinations = set()
    for name, filename, wheel in selected:
        remaining()
        archive = downloads / filename
        digest = hashlib.sha256()
        received = 0
        with opener.open(wheel['url'], timeout=min(20, remaining())) as response, archive.open('xb') as target:
            if response.status != 200:
                fail(f'{name}: wheel HTTP status is not 200')
            length = response.headers.get('Content-Length')
            if length is not None and int(length) != wheel['size']:
                fail(f'{name}: download size mismatch')
            while chunk := response.read(65536):
                remaining()
                received += len(chunk)
                downloaded += len(chunk)
                if received > min(wheel['size'], WHEEL_CAP) or downloaded > DOWNLOAD_CAP:
                    fail(f'{name}: download size/cap exceeded')
                digest.update(chunk)
                target.write(chunk)
        if received != wheel['size']:
            fail(f'{name}: download size mismatch')
        if digest.hexdigest() != wheel['hash'][7:]:
            fail(f'{name}: SHA256 mismatch')
        with zipfile.ZipFile(archive) as bundle:
            plan = []
            for member in bundle.infolist():
                remaining()
                members += 1
                if members > 20000:
                    fail('wheel member count exceeds 20000')
                path = member.filename
                parts = path.rstrip('/').split('/')
                kind = stat.S_IFMT(member.external_attr >> 16)
                if (member.orig_filename != path or path.startswith('/') or '\\' in path or ':' in path
                        or any(p in ('', '.', '..') for p in parts)
                        or kind not in (0, stat.S_IFREG, stat.S_IFDIR)
                        or (kind == stat.S_IFDIR and not member.is_dir())):
                    fail(f'{name}: unsafe ZIP member path/type')
                if parts[0].endswith('.data'):
                    if len(parts) < 3 or parts[1] not in ('purelib', 'platlib'):
                        fail(f'{name}: unsupported wheel data scheme')
                    parts = parts[2:]
                if member.is_dir():
                    continue
                destination = site.joinpath(*parts)
                if destination in destinations:
                    fail(f'{name}: duplicate wheel destination')
                destinations.add(destination)
                extracted += member.file_size
                if member.file_size > FILE_CAP or extracted > EXTRACT_CAP:
                    fail(f'{name}: extracted file/128 MiB total cap exceeded')
                plan.append((member, destination))
            # All metadata and paths checked before extracting this wheel.
            for member, destination in plan:
                remaining()
                destination.parent.mkdir(parents=True, exist_ok=True)
                written = 0
                with bundle.open(member) as source, destination.open('xb') as target:
                    while chunk := source.read(65536):
                        remaining()
                        written += len(chunk)
                        if written > min(member.file_size, FILE_CAP):
                            fail(f'{name}: extracted file size exceeded')
                        target.write(chunk)
                if written != member.file_size:
                    fail(f'{name}: extracted size mismatch')
                if written > largest:
                    largest, largest_name = written, str(destination.relative_to(site))
        archive.unlink()
        print(f'bootstrap verified {name}: {received} wheel bytes', flush=True)
    remaining()
    print(f'bootstrap complete: wheels={len(selected)} download_bytes={downloaded} '
          f'extracted_bytes={extracted} largest_file_bytes={largest} largest_file={largest_name}', flush=True)


def sysconfig_gil_disabled() -> bool:
    import sysconfig
    return bool(sysconfig.get_config_var('Py_GIL_DISABLED'))


signal.signal(signal.SIGALRM, alarm_timeout)
signal.alarm(300)
try:
    bootstrap()
except Exception as error:
    print(f'dependency bootstrap failed: {type(error).__name__}: {str(error)[:300]}', file=sys.stderr)
    sys.exit(1)
finally:
    signal.alarm(0)
BOOTSTRAP_PY
    "$scratch/venv/bin/python3" -B scripts/mac_native/probe.py --suite "$SUITE" --output "$WORKSPACE/evidence/probe.json"
  ) 2>&1 | capture_log "$WORKSPACE/evidence/probe.log"
  cat "$WORKSPACE/evidence/probe.log"
}
# The parent owns scratch and cleanup; no log redirect is active in its EXIT trap.
scratch=$(mktemp -d "$WORKSPACE/native-probe.XXXXXX")
# Preserve the actual failing command status (do not call this function in an if).
(run_probe) 2>&1 | capture_log "$WORKSPACE/evidence/build.log"
]]></command>
    </hudson.tasks.Shell>
  </builders>
  <publishers>
    <hudson.tasks.ArtifactArchiver>
      <artifacts>evidence/*.json,evidence/*.log,evidence/identity.txt</artifacts>
      <allowEmptyArchive>false</allowEmptyArchive><onlyIfSuccessful>false</onlyIfSuccessful>
      <fingerprint>false</fingerprint><defaultExcludes>true</defaultExcludes>
      <caseSensitive>true</caseSensitive><followSymlinks>false</followSymlinks>
    </hudson.tasks.ArtifactArchiver>
  </publishers>
  <buildWrappers>
    <hudson.plugins.build__timeout.BuildTimeoutWrapper>
      <strategy class="hudson.plugins.build_timeout.impl.AbsoluteTimeOutStrategy"><timeoutMinutes>30</timeoutMinutes></strategy>
      <operationList><hudson.plugins.build__timeout.operations.AbortOperation/></operationList>
    </hudson.plugins.build__timeout.BuildTimeoutWrapper>
  </buildWrappers>
</project>
