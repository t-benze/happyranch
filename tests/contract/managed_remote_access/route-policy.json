{
  "version": "1",
  "name": "managed-remote-access-route-policy",
  "status": "normative-contract",
  "description": "Explicit allow-by-method+normalized-template remote-surface policy for the supervised home connector. Merge unit A (TASK-5771) contract only: no runtime behavior. The allow list is the browser-consumed daemon surface (route-classification.json 'included') expressed as explicit method+template entries, MINUS routes the contract forbids remotely even though the local SPA consumes them (auth bootstrap/registration). Every other daemon route is denied by default. This is the structural correction to the legacy Swift deny-list SurfaceAllowList, which canonized 'deny known-bad, allow the rest'.",
  "decision_order": [
    "authenticate",
    "bind",
    "proof",
    "policy",
    "normalize",
    "allowlist",
    "strip",
    "bearer",
    "redact"
  ],
  "default_behavior": "deny_unclassified",
  "normalization": {
    "normalize_once": true,
    "percent_encoding": "decode once with strict validation; reject invalid or overlong percent-encoded octets; reject double-encoding that changes the decoded segment set",
    "dot_segments": "resolve dot and dot-dot segments after decoding; deny any result that escapes the daemon path root or changes the matched template",
    "duplicate_slashes": "collapse consecutive slashes deterministically and re-evaluate against templates; deny when collapsing changes template match outcome",
    "query_separation": "split path at the first '?' for allow-list matching; query strings never participate in route identity",
    "unicode_control_bytes": "reject control bytes, NUL, CR/LF injection, and overlong UTF-8 forms in method, path, or headers",
    "absolute_form_authority": "reject absolute-form request targets (scheme://authority/path) and any authority/host ambiguity",
    "ambiguity_denied": true
  },
  "header_stripping": {
    "strip_authorization": true,
    "strip_forwarding": true,
    "strip_hop_by_hop": true,
    "strip_cookies": true,
    "strip_host": true,
    "daemon_bearer_injection_hop": "connector_to_127.0.0.1_only",
    "inject_only_on_loopback": true,
    "reject_duplicate_critical_headers": true,
    "reject_smuggling": true
  },
  "upgrade_semantics": {
    "allowed": [
      "sse",
      "websocket"
    ],
    "sse": {
      "allowed_templates": [
        "GET /api/v1/orgs/{slug}/threads/{thread_id}/tail",
        "GET /api/v1/orgs/{slug}/jobs/{job_id}/tail"
      ]
    },
    "websocket": {
      "allowed_templates": []
    },
    "unsupported_upgrades_denied": true,
    "unsupported_bodies_denied": true
  },
  "forbidden_classes": [
    {
      "id": "auth_bootstrap_registration",
      "description": "Auth bootstrap and registration-token minting are local-only surfaces. The SPA consumes GET /api/v1/auth/bootstrap against the loopback daemon directly; it must never be reachable through the connector. Any route minting, redeeming, or validating registration tokens is denied remotely.",
      "examples": [
        "GET /api/v1/auth/bootstrap",
        "POST /api/v1/auth/bootstrap",
        "POST /api/v1/auth/registration-token",
        "POST /api/v1/auth/registration-token/runtime"
      ]
    },
    {
      "id": "agent_callbacks",
      "description": "Agent callback/completion/progress and agent-invocation-token routes. These carry single-use invocation tokens, mutate durable task/thread state, and are exercised by agent runtimes over loopback; remote exposure would let a network attacker forge completions or consume single-use tokens.",
      "examples": [
        "POST /api/v1/orgs/{slug}/tasks/{task_id}/completion",
        "POST /api/v1/orgs/{slug}/tasks/{task_id}/progress",
        "POST /api/v1/orgs/{slug}/jobs/submit",
        "POST /api/v1/orgs/{slug}/threads/{thread_id}/reply",
        "POST /api/v1/orgs/{slug}/threads/{thread_id}/decline",
        "POST /api/v1/orgs/{slug}/threads/{thread_id}/dispatch",
        "POST /api/v1/orgs/{slug}/threads/{thread_id}/resolve-escalation",
        "POST /api/v1/orgs/{slug}/threads/compose-as-agent",
        "POST /api/v1/orgs/{slug}/threads/{thread_id}/post-as-agent",
        "POST /api/v1/orgs/{slug}/dreams/{dream_id}/complete",
        "POST /api/v1/orgs/{slug}/work-hours/{work_hour_id}/spawn",
        "POST /api/v1/orgs/{slug}/schedules",
        "POST /api/v1/orgs/{slug}/schedules/{schedule_id}/spawn",
        "POST /api/v1/orgs/{slug}/agents/manage"
      ]
    },
    {
      "id": "management",
      "description": "Operator/agent management routes not consumed by the SPA: executor switching, agent repo management, agent enrollment administration. The founder SPA settings surface is separately and explicitly allowed; these specific management verbs are never remote.",
      "examples": [
        "PUT /api/v1/orgs/{slug}/agents/{agent_name}/executor",
        "POST /api/v1/orgs/{slug}/agents/{agent_name}/repos"
      ]
    },
    {
      "id": "founder_as_founder",
      "description": "Founder-only and --as-founder-prefixed surfaces, including registration-token minting and org-portability reconciliation. Never remotely reachable; a compromised client must not inherit founder privilege.",
      "examples": [
        "POST /api/v1/orgs/{slug}/reconcile-portability",
        "GET /api/v1/orgs/{slug}/portability-preflight",
        "/as-founder"
      ]
    },
    {
      "id": "memory_learning_writes",
      "description": "Agent memory/learning write, promote, reindex, compact, and lifecycle-mutation routes. The SPA consumes only read/search surfaces; every memory/learning WRITE verb is remote-denied.",
      "examples": [
        "POST /api/v1/orgs/{slug}/agents/{agent_name}/memory",
        "POST /api/v1/orgs/{slug}/agents/{agent_name}/memory/entries/",
        "PUT /api/v1/orgs/{slug}/agents/{agent_name}/memory/entries/{id}",
        "POST /api/v1/orgs/{slug}/agents/{agent_name}/memory/entries/{id}/promote",
        "POST /api/v1/orgs/{slug}/agents/{agent_name}/memory/entries/reindex",
        "PATCH /api/v1/orgs/{slug}/agents/{agent_name}/memory/entries/{id}/lifecycle",
        "POST /api/v1/orgs/{slug}/agents/{agent_name}/memory/entries/compact",
        "/learning/"
      ]
    },
    {
      "id": "artifact_upload_agent_only",
      "description": "Artifact upload/list/download routes used by agents and the CLI (agent-facing v1). Upload must never be remote; the remote surface may only expose explicitly allowed browser-consumed artifact operations.",
      "examples": [
        "POST /api/v1/orgs/{slug}/artifacts",
        "GET /api/v1/orgs/{slug}/artifacts",
        "GET /api/v1/orgs/{slug}/artifacts/{name}",
        "GET /api/v1/orgs/{slug}/threads/{thread_id}/attachments",
        "POST /api/v1/orgs/{slug}/threads/{thread_id}/attachments"
      ]
    },
    {
      "id": "adapter_administration",
      "description": "Adapter registration, submission, approval, rejection, and bind-profile administration. Operator/CLI disposition tooling; remote exposure would grant network users control over the adapter authority plane.",
      "examples": [
        "POST /api/v1/runtime/adapters/register",
        "POST /api/v1/runtime/adapters/submit",
        "POST /api/v1/runtime/adapters/{adapter_id}/approve",
        "POST /api/v1/runtime/adapters/{adapter_id}/reject",
        "POST /api/v1/runtime/adapters/{adapter_id}/bind-profile",
        "POST /api/v1/runtime/custom-cli/connect"
      ]
    },
    {
      "id": "executor_registration",
      "description": "Executor registration and conformance check-in (org-level and runtime-level, including binary registration with scoped tokens). Network-exposed registration would let an attacker enroll arbitrary executors.",
      "examples": [
        "POST /api/v1/orgs/{slug}/executors/conformance-checkin",
        "POST /api/v1/orgs/{slug}/executors/register",
        "POST /api/v1/executors/runtime/conformance-checkin",
        "POST /api/v1/executors/runtime/register",
        "POST /api/v1/executors/runtime/register-binary"
      ]
    },
    {
      "id": "portability_reconciliation",
      "description": "Org-portability preflight and reconcile-portability (THR-187). Read-only preflight and founder-only reconciliation are CLI/operator surfaces; never remote.",
      "examples": [
        "GET /api/v1/orgs/{slug}/portability-preflight",
        "POST /api/v1/orgs/{slug}/reconcile-portability"
      ]
    },
    {
      "id": "unclassified_default_deny",
      "description": "Any method+path not explicitly listed in 'allow', including every future daemon route until it is deliberately reviewed and added. Deny-by-default is the normative behavior; a new route is never remotely reachable merely by being browser-consumed locally.",
      "examples": [
        "ANY /api/v1/orgs/{slug}/<new-route-not-in-allow>",
        "ANY /metrics"
      ]
    }
  ],
