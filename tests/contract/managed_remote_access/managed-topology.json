    {"phase": "admission", "ordering": "readiness_then_loopback_bind", "outcome": "full_gateway_pipeline_only", "shipping_tests": ["tests/remote_access/test_managed_provider.py::test_readiness_failure_never_creates_listener_and_is_redacted"]},
    {"phase": "active_flow", "ordering": "authorize_then_final_local_hop", "outcome": "bearer_final_hop_only", "shipping_tests": ["tests/remote_access/test_managed_provider.py::test_complete_gateway_pipeline_and_final_hop_bearer_placement"]},
    {"phase": "readiness_loss", "ordering": "listener_stop_before_downstream_cleanup", "outcome": "no_new_admission", "shipping_tests": ["tests/remote_access/test_supervisor.py::TestRunLoop::test_readiness_loss_stops_listener_immediately"]},
    {"phase": "revocation", "ordering": "listener_stop_then_active_flow_close_then_downstream_cleanup", "outcome": "no_stale_authorization_or_residue", "shipping_tests": ["tests/remote_access/test_supervisor.py::TestReconciliationRotation::test_persisted_revocation_removes_listener_before_stream_cleanup", "tests/remote_access/test_supervisor.py::TestReconciliationRotation::test_cross_process_revoke_closes_stream_then_rotation_reopens_repair"]},
    {"phase": "shutdown", "ordering": "listener_stop_then_active_flow_close_then_runtime_cleanup", "outcome": "repeated_shutdown_exactly_once_no_residue", "shipping_tests": ["tests/remote_access/test_supervisor.py::TestRunLoop::test_repeated_shutdown_closes_active_shipping_runtime_exactly_once"]},
    {"phase": "partial_failure", "ordering": "admission_removed_before_cleanup_retry", "outcome": "category_only_fail_closed", "shipping_tests": ["tests/remote_access/test_streams.py::test_close_all_partial_multi_handle_failure_seals_all", "tests/remote_access/test_supervisor.py::TestReconciliationRotation::test_persisted_revocation_retries_failed_listener_stop_without_double_close", "tests/remote_access/test_supervisor.py::TestRunLoop::test_start_failure_cleans_provider_registry_and_runtime_residue"]},
    {"phase": "concurrency_reentry", "ordering": "provider_start_races_shutdown_or_persisted_revocation", "outcome": "linearized_both_orderings_no_deadlock_or_double_close", "shipping_tests": ["tests/remote_access/test_supervisor.py::TestRunLoop::test_concurrent_provider_start_then_shutdown_is_linearized", "tests/remote_access/test_supervisor.py::TestReconciliationRotation::test_provider_start_racing_persisted_revocation_is_linearized_in_both_orderings"]},
    {"phase": "recovery", "ordering": "fresh_gates_after_cleanup_before_fresh_listener", "outcome": "current_identity_epoch_policy_only", "shipping_tests": ["tests/remote_access/test_managed_provider.py::test_stop_is_idempotent_and_recovery_requires_fresh_readiness", "tests/remote_access/test_supervisor.py::TestReconciliationRotation::test_targeted_revoke_rotation_unaffected_device_still_opens_and_ws_denied"]}
