{
  "version": "1.0.0", "name": "HappyRanch managed embedded-network topology", "status": "normative-contract",
  "description": "N0 contract plus N1 sidecar core and N2 Python managed-loopback ingress; no packaging, provisioning, distribution, deployment, or acceptance claim.",
  "transport": "embedded",
