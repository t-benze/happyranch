  "visibility": {"headscale_derp_may_observe": ["operational_metadata", "wireguard_ciphertext"], "headscale_derp_must_never_observe": ["http_plaintext", "sse_plaintext", "websocket_plaintext", "happy_ranch_secrets"]},
