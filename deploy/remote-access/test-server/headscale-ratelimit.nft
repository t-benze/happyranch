# Dedicated table only. Never flush ruleset or touch the website/other tables.
# Per source address (including devices behind the same NAT): generous bursts.
table inet happyranch_headscale {
    set tcp4 { type ipv4_addr; flags dynamic,timeout; timeout 1m; size 65535; }
    set tcp6 { type ipv6_addr; flags dynamic,timeout; timeout 1m; size 65535; }
    set udp4 { type ipv4_addr; flags dynamic,timeout; timeout 1m; size 65535; }
    set udp6 { type ipv6_addr; flags dynamic,timeout; timeout 1m; size 65535; }

    chain input {
        type filter hook input priority -10; policy accept;
        tcp dport 8443 ct state new update @tcp4 { ip saddr limit rate over 30/second burst 120 packets } counter drop
        tcp dport 8443 ct state new update @tcp6 { ip6 saddr limit rate over 30/second burst 120 packets } counter drop
        udp dport 3478 update @udp4 { ip saddr limit rate over 100/second burst 400 packets } counter drop
        udp dport 3478 update @udp6 { ip6 saddr limit rate over 100/second burst 400 packets } counter drop
    }
}
