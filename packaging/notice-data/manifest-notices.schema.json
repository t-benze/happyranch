{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HappyRanch packaged manifest notices v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "standard", "inventory_sha256", "components"],
  "properties": {
    "schema": {"const": "happyranch-manifest-notices@1"},
    "standard": {"const": "resolved dependency manifests and separate bundled asset notices"},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "components": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "family", "component", "version", "source", "selection", "notices"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "family": {"enum": ["npm", "go", "python", "runtime", "asset", "project"]},
          "component": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "selection": {"type": "string", "pattern": "^(included|excluded): .+"},
          "notices": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["source", "source_sha256", "destination", "sha256"],
              "properties": {
                "source": {"type": "string", "minLength": 1},
                "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "destination": {"type": "string", "pattern": "^Contents/Resources/licenses/manifest/"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  },
  "$comment": "The stdlib validator additionally rederives membership from resolved-inventory.json, compares live inputs at licenses, enforces included/excluded text associations, safe paths, nonempty UTF8 originals, digests and actual candidate/archive bytes. JSON Schema alone cannot establish those relations. No runtime DB schema is changed."
}
