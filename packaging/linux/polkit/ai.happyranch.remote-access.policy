<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>HappyRanch</vendor>
  <action id="ai.happyranch.remote-access.approve-pending">
    <description>Approve the pending HappyRanch device</description>
    <message>Authenticate to approve this device</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  </action>
  <action id="ai.happyranch.remote-access.reject-pending">
    <description>Reject the pending HappyRanch device</description>
    <message>Authenticate to reject this device</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  </action>
  <action id="ai.happyranch.remote-access.revoke-selected">
    <description>Revoke the selected HappyRanch device</description>
    <message>Authenticate to revoke this device</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  </action>
  <action id="ai.happyranch.remote-access.enable">
    <description>Enable home remote access</description>
    <message>Authenticate to enable home remote access</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  </action>
  <action id="ai.happyranch.remote-access.replace-failed">
    <description>Replace failed remote access and remove pairings</description>
    <message>Authenticate to replace failed remote access and remove pairings</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  </action>
  <action id="ai.happyranch.remote-access.disable">
    <description>Turn off home remote access and revoke devices</description>
    <message>Authenticate to turn off home remote access and revoke devices</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  </action>
  <action id="ai.happyranch.remote-access.cancel-invite">
    <description>Cancel the current home remote access invite</description>
    <message>Authenticate to cancel the current invite</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  </action>
  <action id="ai.happyranch.remote-access.recover-invite">
    <description>Recover the current home remote access invite</description>
    <message>Authenticate to recover the current invite</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  </action>
  <action id="ai.happyranch.remote-access.issue-invite">
    <description>Issue a home remote access invite</description>
    <message>Authenticate to issue a home remote access invite</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  </action>
</policyconfig>
