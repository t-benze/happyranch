[Unit]
Description=HappyRanch embedded tsnet sidecar
After=network-online.target happyranch-connector.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
BindsTo=happyranch-connector.service
PartOf=happyranch-managed.target

[Service]
ExecStart=/opt/happyranch-desktop/bin/happyranch-tsnet-sidecar --config /etc/happyranch/sidecar.json --credential-file ${CREDENTIALS_DIRECTORY}/enrollment-key
LoadCredential=enrollment-key:happyranch-tsnet-enrollment
User=happyranch
Group=happyranch
NotifyAccess=main
RestartSec=1
WatchdogSec=30
TimeoutStartSec=120
TimeoutStopSec=35
Type=notify
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
PrivateDevices=yes
ProtectKernelModules=yes
CapabilityBoundingSet=
AmbientCapabilities=
StateDirectory=happyranch-tsnet-sidecar
StateDirectoryMode=0700
RuntimeDirectory=happyranch-tsnet-sidecar
RuntimeDirectoryPreserve=yes
LogsDirectory=happyranch-tsnet-sidecar

[Install]
WantedBy=happyranch-managed.target
