[Unit]
Description=HappyRanch remote-access connector (supervised Linux home connector)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
PartOf=happyranch-managed.target
Requires=happyranch-release-verifier.socket
After=happyranch-release-verifier.socket
Upholds=happyranch-tsnet-sidecar.service

[Service]
ExecStart=/opt/happyranch-desktop/python/bin/python3 -I -m runtime.remote_access.cli run --managed --config /etc/happyranch/connector.json
User=happyranch
Group=happyranch
RestartSec=1
WatchdogSec=30
TimeoutStopSec=10
TimeoutStartSec=120
NotifyAccess=main
Type=notify
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
PrivateDevices=yes
ProtectKernelModules=yes
CapabilityBoundingSet=
AmbientCapabilities=
StateDirectory=happyranch-connector
RuntimeDirectory=happyranch-connector
RuntimeDirectoryMode=0700
LogsDirectory=happyranch-connector

[Install]
WantedBy=multi-user.target
